<?php
/**
 * LOCAL SECRETS — copy this file to config.secrets.php and fill in.
 * config.secrets.php is git-ignored, so DO NOT put real credentials here.
 *
 * Each putenv() below overrides the environment defaults read in config.php.
 */

putenv('MAIL_FROM=noreply@gmail.com');        // sender address (your Gmail)
putenv('MAIL_FROM_NAME=Aurora Cyber');        // display name on outbound mail
putenv('MAIL_HOST=smtp.gmail.com');           // Gmail SMTP
putenv('MAIL_PORT=587');                      // TLS port
putenv('MAIL_USER=you@gmail.com');            // your Gmail address
putenv('MAIL_PASS=your-16-char-app-password');// Gmail App Password (not the login password)
putenv('MAIL_ENCRYPTION=tls');