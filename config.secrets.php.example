<?php
/**
 * LOCAL SECRETS — copy this file to config.secrets.php and fill in.
 * config.secrets.php is git-ignored, so DO NOT put real credentials here.
 *
 * Define SECRET_* constants (not putenv — many hosts like InfinityFree
 * disable putenv() in php.ini, so env overrides would never be applied).
 * Values are picked up by ac_env() in config.php.
 */

/* --- DATABASE (InfinityFree → "MySQL Databases" in the control panel) --- */
define('SECRET_DB_HOST', 'sqlXXX.infinityfree.com'); // remote MySQL hostname (or 127.0.0.1 locally)
define('SECRET_DB_PORT', 3306);
define('SECRET_DB_NAME', 'if0_XXXXXXX_yourdb');
define('SECRET_DB_USER', 'if0_XXXXXXX');
define('SECRET_DB_PASS', 'your-db-password');
define('SECRET_APP_ENV', 'prod'); // 'prod' hides errors, 'dev' shows them

/* --- EMAIL (site mail account) --- */
define('SECRET_MAIL_FROM', 'you@gmail.com');                   // sender address (your Gmail)
define('SECRET_MAIL_FROM_NAME', 'Aurora Cyber');               // display name on outbound mail
define('SECRET_MAIL_HOST', 'smtp.gmail.com');                  // Gmail SMTP
define('SECRET_MAIL_PORT', 587);                               // TLS port
define('SECRET_MAIL_USER', 'you@gmail.com');                   // your Gmail address
define('SECRET_MAIL_PASS', 'your-16-char-app-password');       // Gmail App Password (not the login password)
define('SECRET_MAIL_ENCRYPTION', 'tls');